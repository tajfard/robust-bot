# Telegram
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321   # comma-separated Telegram user IDs

# MikroTik
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_password
# Per-plan User Manager profile names (create these in MikroTik User Manager → Profiles)
PLAN_PROFILE_TEST=test
PLAN_PROFILE_1GB=1gb-1mo
PLAN_PROFILE_5GB=5gb-1mo
PLAN_PROFILE_15GB=15gb-1mo
PLAN_PROFILE_50GB=50gb-3mo

# Exchange rate for displaying Tooman prices (e.g. 600000 means 1 USD = 600,000 Tooman)
USD_TO_TOOMAN=600000

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Crypto — USDT TRC20 (Tron)
TRON_WALLET_ADDRESS=TXxxx...
TRONGRID_API_KEY=your_trongrid_api_key   # free at trongrid.io

# Crypto — USDT ERC20 (Ethereum)
ETH_WALLET_ADDRESS=0x...
ETHERSCAN_API_KEY=your_etherscan_api_key  # free at etherscan.io

# Bank transfer (manual approval)
BANK_CARD_NUMBER=6037-xxxx-xxxx-xxxx
BANK_ACCOUNT_NAME=Your Name
BANK_NAME=Bank Name

# Database
DATABASE_URL=sqlite:///vpn_bot.db
